# ByteDocs Configuration Example
# Copy this file to .env and update with your values

# ============================================================================
# Basic Settings
# ============================================================================

BYTEDOCS_TITLE="My API Documentation"
BYTEDOCS_VERSION="1.0.0"
BYTEDOCS_DESCRIPTION="API for my awesome application"
BYTEDOCS_DOCS_PATH="/docs"
BYTEDOCS_AUTO_DETECT=true

# Paths to exclude from documentation (comma-separated)
BYTEDOCS_EXCLUDE_PATHS=/admin,/internal

# ============================================================================
# Base URLs (Multiple Environments)
# ============================================================================

# Production environment
BYTEDOCS_PRODUCTION_URL="https://api.production.com"

# Staging environment
BYTEDOCS_STAGING_URL="https://api.staging.com"

# Development/Local environment
BYTEDOCS_LOCAL_URL="http://localhost:3000"

# Or use single base URL (backward compatibility)
# BYTEDOCS_BASE_URL="http://localhost:3000"

# ============================================================================
# Authentication
# ============================================================================

# Enable authentication (true/false)
BYTEDOCS_AUTH_ENABLED=true

# Auth type: session, basic, api_key, bearer
BYTEDOCS_AUTH_TYPE=session

# Session-based authentication
BYTEDOCS_AUTH_PASSWORD=SecurePassword123!
BYTEDOCS_AUTH_SESSION_EXPIRE=1440

# IP banning settings
BYTEDOCS_AUTH_IP_BAN_ENABLED=true
BYTEDOCS_AUTH_IP_BAN_MAX_ATTEMPTS=5
BYTEDOCS_AUTH_IP_BAN_DURATION=30

# Whitelisted IPs (comma-separated)
BYTEDOCS_AUTH_ADMIN_WHITELIST_IPS=127.0.0.1,::1

# Basic authentication (if type=basic)
# BYTEDOCS_AUTH_USERNAME=admin
# BYTEDOCS_AUTH_PASSWORD=secret

# API Key authentication (if type=api_key)
# BYTEDOCS_AUTH_API_KEY=your-api-key-here
# BYTEDOCS_AUTH_API_KEY_HEADER=X-API-Key

# Bearer token authentication (if type=bearer)
# BYTEDOCS_AUTH_BEARER_TOKEN=your-bearer-token-here

# ============================================================================
# UI Settings
# ============================================================================

# Theme color: green, blue, purple, red, orange, teal, pink
BYTEDOCS_UI_THEME=green

# Enable dark mode by default (true/false)
BYTEDOCS_UI_DARK_MODE=false

# ============================================================================
# AI Configuration (Optional)
# ============================================================================

# Enable AI features (true/false)
BYTEDOCS_AI_ENABLED=false

# AI Provider: openai, gemini, claude, openrouter
BYTEDOCS_AI_PROVIDER=openai

# AI API Key
BYTEDOCS_AI_API_KEY=your-ai-api-key-here

# AI Features
BYTEDOCS_AI_CHAT_ENABLED=true
BYTEDOCS_AI_DOC_GENERATION_ENABLED=true

# AI Model settings
BYTEDOCS_AI_MODEL=gpt-4
BYTEDOCS_AI_MAX_TOKENS=4096
BYTEDOCS_AI_MAX_COMPLETION_TOKENS=2048
BYTEDOCS_AI_TEMPERATURE=0.7
